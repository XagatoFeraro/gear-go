# Public business details. These are rendered in the browser; never put secrets here.
# Copy to .env.local and fill in only what the owner has confirmed.

# Deployment (project Pages testing)
NEXT_PUBLIC_BASE_PATH=/gear-go
NEXT_PUBLIC_SITE_URL=https://xagatoferaro.github.io/gear-go

# Contact channels — leave blank until confirmed. Blank means CTAs fall back to the enquiry form.
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_E164=
NEXT_PUBLIC_WHATSAPP_DISPLAY=
NEXT_PUBLIC_WHATSAPP_E164=
NEXT_PUBLIC_EMAIL=

# Hours — pipe-separated rows. Leave blank to show "Confirm hours when you enquire".
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_HOLIDAY_NOTE=
NEXT_PUBLIC_PARKING_NOTE=
# JSON array only, e.g. [{"dayOfWeek":["Monday"],"opens":"09:00","closes":"19:00"}]
NEXT_PUBLIC_OPENING_HOURS_JSON=

# Maps — directions has a real fallback from the address; place/embed stay blank until confirmed.
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_DIRECTIONS_URL=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Public profiles — used only for structured data when confirmed.
NEXT_PUBLIC_GBP_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Enquiry form — public provider key/endpoint only. Leave blank for copy-and-send handoff.
NEXT_PUBLIC_FORM_PROVIDER=
NEXT_PUBLIC_FORM_ENDPOINT=
